/* ============================================================================
 * SEHRISH BIRTHDAY WEBSITE
 * File: js/theme.js
 * Version: 1.0.0
 *
 * Production-ready visual theme controller.
 *
 * Responsibilities:
 * - Central theme configuration
 * - CSS custom property management
 * - Theme state management
 * - Scene-based visual moods
 * - Theme class synchronization
 * - Runtime theme updates
 * - Decorative accent control
 * - Persistent theme state
 * - Accessibility-aware theme updates
 * - Integration with navigation / scenes
 * - Public API
 *
 * ========================================================================== */

(() => {
    "use strict";

    /* ------------------------------------------------------------------------
     * CONSTANTS
     * --------------------------------------------------------------------- */

    const VERSION = "1.0.0";

    const STORAGE_KEY =
        "sehrish-birthday-theme-v1";

    const DEFAULT_THEME = Object.freeze({
        name: "birthday",

        mood: "default",

        colors: {
            pink: "#F7B8D8",
            pinkSoft: "#FDE4F0",
            lavender: "#CFC4F7",
            lavenderSoft: "#EEE9FF",
            cream: "#FFF7E8",
            mint: "#CFEFE2",
            mintSoft: "#EAF9F2",
            yellow: "#F9E79F",
            white: "#FFFFFF",
            text: "#5E5368",
            textSoft: "#8A7F92"
        },

        effects: {
            glow:
                true,

            sparkles:
                true,

            floatingDecorations:
                true,

            softShadow:
                true,

            backgroundMotion:
                true
        },

        intensity: 1
    });

    const MOODS = Object.freeze({
        default: {
            name:
                "birthday",

            accent:
                "pink",

            secondary:
                "lavender",

            background:
                "cream"
        },

        welcome: {
            name:
                "welcome",

            accent:
                "pink",

            secondary:
                "yellow",

            background:
                "cream"
        },

        memories: {
            name:
                "memories",

            accent:
                "lavender",

            secondary:
                "pink",

            background:
                "cream"
        },

        quiz: {
            name:
                "quiz",

            accent:
                "mint",

            secondary:
                "pink",

            background:
                "cream"
        },

        gifts: {
            name:
                "gifts",

            accent:
                "pink",

            secondary:
                "yellow",

            background:
                "cream"
        },

        cake: {
            name:
                "cake",

            accent:
                "yellow",

            secondary:
                "pink",

            background:
                "cream"
        },

        letter: {
            name:
                "letter",

            accent:
                "lavender",

            secondary:
                "mint",

            background:
                "cream"
        },

        celebration: {
            name:
                "celebration",

            accent:
                "pink",

            secondary:
                "yellow",

            background:
                "cream"
        }
    });

    const EVENTS = Object.freeze({
        ready:
            "sehrish:theme:ready",

        changed:
            "sehrish:theme:changed",

        moodChanged:
            "sehrish:theme:mood-changed",

        intensityChanged:
            "sehrish:theme:intensity-changed",

        reset:
            "sehrish:theme:reset"
    });

    /* ------------------------------------------------------------------------
     * UTILITY FUNCTIONS
     * --------------------------------------------------------------------- */

    const clamp = (
        value,
        min,
        max
    ) => {
        return Math.min(
            Math.max(
                value,
                min
            ),
            max
        );
    };

    const normalizeName = (
        value,
        fallback
    ) => {
        const normalized =
            String(
                value ??
                    fallback
            )
                .trim()
                .toLowerCase()
                .replace(
                    /\s+/g,
                    "-"
                );

        return (
            normalized ||
            fallback
        );
    };

    const isObject = (
        value
    ) => {
        return (
            value !== null &&
            typeof value ===
                "object" &&
            !Array.isArray(
                value
            )
        );
    };

    const mergeDeep = (
        base,
        override
    ) => {
        const result = {
            ...base
        };

        Object.keys(
            override || {}
        ).forEach(
            (
                key
            ) => {
                const baseValue =
                    result[key];

                const overrideValue =
                    override[key];

                if (
                    isObject(
                        baseValue
                    ) &&
                    isObject(
                        overrideValue
                    )
                ) {
                    result[key] =
                        mergeDeep(
                            baseValue,
                            overrideValue
                        );
                } else {
                    result[key] =
                        overrideValue;
                }
            }
        );

        return result;
    };

    const dispatch = (
        eventName,
        detail = {}
    ) => {
        try {
            window.dispatchEvent(
                new CustomEvent(
                    eventName,
                    {
                        detail
                    }
                )
            );
        } catch {
            /* Ignore custom event failures. */
        }
    };

    /* ------------------------------------------------------------------------
     * THEME MANAGER
     * --------------------------------------------------------------------- */

    class BirthdayThemeManager {
        constructor(
            options = {}
        ) {
            this.options = {
                persist:
                    true,

                storageKey:
                    STORAGE_KEY,

                ...options
            };

            this.theme =
                mergeDeep(
                    DEFAULT_THEME,
                    options.theme ||
                        {}
                );

            this.currentMood =
                this.theme.mood ||
                "default";

            this.initialized =
                false;

            this.destroyed =
                false;

            this.listeners =
                [];

            this.sceneListenerBound =
                false;
        }

        /* --------------------------------------------------------------------
         * INITIALIZATION
         * ----------------------------------------------------------------- */

        init(
            options = {}
        ) {
            if (
                this.destroyed
            ) {
                return this;
            }

            this.options = {
                ...this.options,
                ...options
            };

            this.load();

            this.applyBaseTheme();

            this.applyMood(
                this.currentMood,
                {
                    emit:
                        false,

                    persist:
                        false,

                    initialize:
                        true
                }
            );

            this.bindEvents();

            this.initialized =
                true;

            dispatch(
                EVENTS.ready,
                {
                    manager:
                        this,

                    theme:
                        this.getState()
                }
            );

            return this;
        }

        /* --------------------------------------------------------------------
         * EVENT BINDING
         * ----------------------------------------------------------------- */

        bindEvents() {
            if (
                this.sceneListenerBound
            ) {
                return;
            }

            this.sceneListenerBound =
                true;

            this.addListener(
                window,
                "sehrish:navigation:change",
                (
                    event
                ) =>
                    this.handleNavigationChange(
                        event
                    )
            );

            this.addListener(
                window,
                "sehrish:scene:enter",
                (
                    event
                ) =>
                    this.handleSceneEnter(
                        event
                    )
            );
        }

        addListener(
            target,
            eventName,
            handler
        ) {
            target.addEventListener(
                eventName,
                handler
            );

            this.listeners.push({
                target,
                eventName,
                handler
            });
        }

        /* --------------------------------------------------------------------
         * BASE THEME
         * ----------------------------------------------------------------- */

        applyBaseTheme() {
            const root =
                document.documentElement;

            const colors =
                this.theme.colors;

            Object.entries(
                colors
            ).forEach(
                (
                    [
                        name,
                        value
                    ]
                ) => {
                    root.style.setProperty(
                        `--birthday-${this.toKebabCase(
                            name
                        )}`,
                        value
                    );
                }
            );

            root.style.setProperty(
                "--birthday-theme-intensity",
                String(
                    this.theme.intensity
                )
            );

            root.dataset.theme =
                this.theme.name;

            root.dataset.themeMood =
                this.currentMood;

            document.body?.classList.add(
                "birthday-theme-active"
            );

            if (document.body) {
                document.body.dataset.theme =
                this.theme.name;
            }
        }

        /* --------------------------------------------------------------------
         * MOOD
         * ----------------------------------------------------------------- */

        applyMood(
            mood,
            options = {}
        ) {
            const normalized =
                normalizeName(
                    mood,
                    "default"
                );

            const moodConfig =
                MOODS[
                    normalized
                ] ||
                MOODS.default;

            const previousMood =
                this.currentMood;

            this.currentMood =
                normalized;

            const root =
                document.documentElement;

            const body =
                document.body;

            if (!root) {
                return this;
            }

            root.dataset.themeMood =
                normalized;

            if (body) {
                body.dataset.themeMood =
                    normalized;
            }

            Object.keys(
                MOODS
            ).forEach(
                (
                    moodName
                ) => {
                    root.classList.remove(
                        `theme-mood-${moodName}`
                    );

                    body?.classList.remove(
                        `theme-mood-${moodName}`
                    );
                }
            );

            root.classList.add(
                `theme-mood-${normalized}`
            );

            body?.classList.add(
                `theme-mood-${normalized}`
            );

            this.applyMoodVariables(
                moodConfig
            );

            if (
                options.emit !== false &&
                previousMood !==
                    normalized
            ) {
                dispatch(
                    EVENTS.moodChanged,
                    {
                        manager:
                            this,

                        previous:
                            previousMood,

                        current:
                            normalized,

                        config:
                            moodConfig
                    }
                );

                dispatch(
                    EVENTS.changed,
                    {
                        manager:
                            this,

                        state:
                            this.getState()
                    }
                );
            }

            if (
                options.persist !==
                false
            ) {
                this.persist();
            }

            return this;
        }

        /* --------------------------------------------------------------------
         * MOOD VARIABLES
         * ----------------------------------------------------------------- */

        applyMoodVariables(
            mood
        ) {
            const root =
                document.documentElement;

            const colors =
                this.theme.colors;

            const accent =
                colors[
                    mood.accent
                ] ||
                colors.pink;

            const secondary =
                colors[
                    mood.secondary
                ] ||
                colors.lavender;

            const background =
                colors[
                    mood.background
                ] ||
                colors.cream;

            root.style.setProperty(
                "--birthday-accent",
                accent
            );

            root.style.setProperty(
                "--birthday-secondary",
                secondary
            );

            root.style.setProperty(
                "--birthday-background",
                background
            );

            root.style.setProperty(
                "--birthday-accent-soft",
                this.getSoftColor(
                    mood.accent
                )
            );

            root.style.setProperty(
                "--birthday-secondary-soft",
                this.getSoftColor(
                    mood.secondary
                )
            );
        }

        /* --------------------------------------------------------------------
         * SOFT COLORS
         * ----------------------------------------------------------------- */

        getSoftColor(
            colorName
        ) {
            const softMap = {
                pink:
                    this.theme.colors
                        .pinkSoft,

                lavender:
                    this.theme.colors
                        .lavenderSoft,

                mint:
                    this.theme.colors
                        .mintSoft,

                cream:
                    this.theme.colors
                        .cream,

                yellow:
                    this.theme.colors
                        .yellow
            };

            return (
                softMap[
                    colorName
                ] ||
                this.theme.colors
                    .cream
            );
        }

        /* --------------------------------------------------------------------
         * NAVIGATION INTEGRATION
         * ----------------------------------------------------------------- */

        handleNavigationChange(
            event
        ) {
            const detail =
                event.detail ||
                {};

            const scene =
                detail.toScene ||
                detail.scene;

            const sceneElement =
                scene?.element ||
                (
                    scene instanceof
                    HTMLElement
                        ? scene
                        : null
                );

            if (
                sceneElement
            ) {
                this.applySceneMood(
                    sceneElement
                );
            }
        }

        handleSceneEnter(
            event
        ) {
            const detail =
                event.detail ||
                {};

            const scene =
                detail.scene;

            const element =
                scene?.element ||
                (
                    scene instanceof
                    HTMLElement
                        ? scene
                        : null
                );

            if (
                element
            ) {
                this.applySceneMood(
                    element
                );
            }
        }

        /* --------------------------------------------------------------------
         * SCENE MOOD
         * ----------------------------------------------------------------- */

        applySceneMood(
            scene
        ) {
            if (
                !scene
            ) {
                return this;
            }

            const explicitMood =
                scene.dataset
                    ?.themeMood ||
                scene.dataset
                    ?.sceneMood;

            if (
                explicitMood
            ) {
                this.setMood(
                    explicitMood
                );

                return this;
            }

            const sceneType =
                normalizeName(
                    scene.dataset
                        ?.sceneType,
                    ""
                );

            const sceneId =
                normalizeName(
                    scene.dataset
                        ?.scene,
                    ""
                );

            const automaticMood =
                this.resolveAutomaticMood(
                    sceneId,
                    sceneType
                );

            if (
                automaticMood
            ) {
                this.setMood(
                    automaticMood
                );
            }

            return this;
        }

        resolveAutomaticMood(
            sceneId,
            sceneType
        ) {
            const knownNames = [
                "welcome",
                "memories",
                "quiz",
                "gifts",
                "cake",
                "letter",
                "celebration"
            ];

            if (
                knownNames.includes(
                    sceneId
                )
            ) {
                return sceneId;
            }

            if (
                knownNames.includes(
                    sceneType
                )
            ) {
                return sceneType;
            }

            return "default";
        }

        /* --------------------------------------------------------------------
         * SET MOOD
         * ----------------------------------------------------------------- */

        setMood(
            mood,
            options = {}
        ) {
            return this.applyMood(
                mood,
                options
            );
        }

        /* --------------------------------------------------------------------
         * SET THEME NAME
         * ----------------------------------------------------------------- */

        setThemeName(
            name,
            options = {}
        ) {
            const normalized =
                normalizeName(
                    name,
                    "birthday"
                );

            this.theme.name =
                normalized;

            document.documentElement.dataset.theme =
                normalized;

            document.body?.classList.remove(
                "birthday-theme-active"
            );

            document.body?.classList.add(
                "birthday-theme-active"
            );

            if (document.body) {
                document.body.dataset.theme =
                normalized;
            }       

            if (
                options.emit !== false
            ) {
                dispatch(
                    EVENTS.changed,
                    {
                        manager:
                            this,

                        reason:
                            "theme-name",

                        theme:
                            normalized
                    }
                );
            }

            this.persist();

            return this;
        }

        /* --------------------------------------------------------------------
         * SET COLOR
         * ----------------------------------------------------------------- */

        setColor(
            name,
            value,
            options = {}
        ) {
            const key =
                String(
                    name || ""
                )
                    .trim()
                    .replace(
                        /([A-Z])/g,
                        "-$1"
                    )
                    .toLowerCase();

            const normalizedValue =
                String(
                    value || ""
                ).trim();

            if (
                !key ||
                !normalizedValue
            ) {
                return false;
            }

            this.theme.colors[
                this.fromKebabCase(
                    key
                )
            ] =
                normalizedValue;

            document.documentElement.style.setProperty(
                `--birthday-${key}`,
                normalizedValue
            );

            this.applyMoodVariables(
                MOODS[
                    this.currentMood
                ] ||
                    MOODS.default
            );

            if (
                options.emit !==
                false
            ) {
                dispatch(
                    EVENTS.changed,
                    {
                        manager:
                            this,

                        reason:
                            "color",

                        name:
                            key,

                        value:
                            normalizedValue
                    }
                );
            }

            this.persist();

            return true;
        }

        /* --------------------------------------------------------------------
         * SET MULTIPLE COLORS
         * ----------------------------------------------------------------- */

        setColors(
            colors = {},
            options = {}
        ) {
            if (
                !isObject(
                    colors
                )
            ) {
                return false;
            }

            Object.entries(
                colors
            ).forEach(
                (
                    [
                        name,
                        value
                    ]
                ) => {
                    this.setColor(
                        name,
                        value,
                        {
                            emit:
                                false
                        }
                    );
                }
            );

            this.applyMoodVariables(
                MOODS[
                    this.currentMood
                ] ||
                    MOODS.default
            );

            if (
                options.emit !==
                false
            ) {
                dispatch(
                    EVENTS.changed,
                    {
                        manager:
                            this,

                        reason:
                            "colors",

                        colors:
                            {
                                ...colors
                            }
                    }
                );
            }

            this.persist();

            return true;
        }

        /* --------------------------------------------------------------------
         * EFFECT SETTINGS
         * ----------------------------------------------------------------- */

        setEffect(
            effect,
            enabled,
            options = {}
        ) {
            const key =
                normalizeName(
                    effect,
                    ""
                );

            if (
                !key ||
                !Object.prototype.hasOwnProperty.call(
                    this.theme.effects,
                    key
                )
            ) {
                return false;
            }

            this.theme.effects[
                key
            ] =
                Boolean(
                    enabled
                );

            document.documentElement.dataset[
                `effect${this.toPascalCase(
                    key
                )}`
            ] =
                this.theme.effects[
                    key
                ]
                    ? "true"
                    : "false";

            document.documentElement.classList.toggle(
                `effect-disabled-${key}`,
                !this.theme.effects[
                    key
                ]
            );

            if (
                options.emit !==
                false
            ) {
                dispatch(
                    EVENTS.changed,
                    {
                        manager:
                            this,

                        reason:
                            "effect",

                        effect:
                            key,

                        enabled:
                            this.theme.effects[
                                key
                            ]
                    }
                );
            }

            this.persist();

            return true;
        }

        /* --------------------------------------------------------------------
         * INTENSITY
         * ----------------------------------------------------------------- */

        setIntensity(
            value,
            options = {}
        ) {
            const intensity =
                clamp(
                    Number(
                        value
                    ) || 1,
                    0,
                    2
                );

            this.theme.intensity =
                intensity;

            document.documentElement.style.setProperty(
                "--birthday-theme-intensity",
                String(
                    intensity
                )
            );

            document.documentElement.dataset.themeIntensity =
                String(
                    intensity
                );

            dispatch(
                EVENTS.intensityChanged,
                {
                    manager:
                        this,

                    intensity
                }
            );

            if (
                options.emit !==
                false
            ) {
                dispatch(
                    EVENTS.changed,
                    {
                        manager:
                            this,

                        reason:
                            "intensity"
                    }
                );
            }

            this.persist();

            return this;
        }

        /* --------------------------------------------------------------------
         * RESET
         * ----------------------------------------------------------------- */

        reset(
            options = {}
        ) {
            this.theme =
                mergeDeep(
                    DEFAULT_THEME,
                    {}
                );

            this.currentMood =
                "default";

            this.applyBaseTheme();

            this.applyMood(
                "default",
                {
                    emit:
                        false,

                    persist:
                        false
                }
            );

            dispatch(
                EVENTS.reset,
                {
                    manager:
                        this
                }
            );

            if (
                options.clearStorage !==
                false
            ) {
                try {
                    localStorage.removeItem(
                        this.options
                            .storageKey
                    );
                } catch {
                    /*
                     * Ignore storage errors.
                     */
                }
            }

            return this;
        }

        /* --------------------------------------------------------------------
         * PERSIST
         * ----------------------------------------------------------------- */

        persist() {
            if (
                !this.options
                    .persist
            ) {
                return;
            }

            try {
                localStorage.setItem(
                    this.options
                        .storageKey,
                    JSON.stringify(
                        {
                            version:
                                VERSION,

                            theme:
                                this.theme,

                            currentMood:
                                this.currentMood,

                            savedAt:
                                Date.now()
                        }
                    )
                );
            } catch {
                /*
                 * LocalStorage may be unavailable.
                 */
            }
        }

        /* --------------------------------------------------------------------
         * LOAD
         * ----------------------------------------------------------------- */

        load() {
            if (
                !this.options
                    .persist
            ) {
                return;
            }

            try {
                const raw =
                    localStorage.getItem(
                        this.options
                            .storageKey
                    );

                if (!raw) {
                    return;
                }

                const saved =
                    JSON.parse(
                        raw
                    );

                if (
                    !saved ||
                    typeof saved !==
                        "object"
                ) {
                    return;
                }

                if (
                    isObject(
                        saved.theme
                    )
                ) {
                    this.theme =
                        mergeDeep(
                            DEFAULT_THEME,
                            saved.theme
                        );
                }

                if (
                    typeof saved.currentMood ===
                    "string"
                ) {
                    this.currentMood =
                        normalizeName(
                            saved.currentMood,
                            "default"
                        );
                }
            } catch {
                /*
                 * Corrupt or unavailable
                 * storage falls back to
                 * the default theme.
                 */
            }
        }

        /* --------------------------------------------------------------------
         * GET MOOD
         * ----------------------------------------------------------------- */

        getMood() {
            return (
                this.currentMood
            );
        }

        /* --------------------------------------------------------------------
         * GET THEME
         * ----------------------------------------------------------------- */

        getTheme() {
            return mergeDeep(
                this.theme,
                {}
            );
        }

        /* --------------------------------------------------------------------
         * STATE
         * ----------------------------------------------------------------- */

        getState() {
            return {
                version:
                    VERSION,

                initialized:
                    this.initialized,

                theme:
                    this.getTheme(),

                currentMood:
                    this.currentMood,

                effects:
                    {
                        ...this.theme
                            .effects
                    },

                intensity:
                    this.theme
                        .intensity
            };
        }

        /* --------------------------------------------------------------------
         * HELPERS
         * ----------------------------------------------------------------- */

        toKebabCase(
            value
        ) {
            return String(
                value
            )
                .replace(
                    /([a-z])([A-Z])/g,
                    "$1-$2"
                )
                .replace(
                    /\s+/g,
                    "-"
                )
                .toLowerCase();
        }

        fromKebabCase(
            value
        ) {
            return String(
                value
            ).replace(
                /-([a-z])/g,
                (
                    _match,
                    letter
                ) =>
                    letter.toUpperCase()
            );
        }

        toPascalCase(
            value
        ) {
            return String(
                value
            )
                .split(
                    "-"
                )
                .map(
                    (
                        part
                    ) =>
                        part
                            .charAt(
                                0
                            )
                            .toUpperCase() +
                        part.slice(
                            1
                        )
                )
                .join(
                    ""
                );
        }

        /* --------------------------------------------------------------------
         * REFRESH
         * ----------------------------------------------------------------- */

        refresh() {
            this.applyBaseTheme();

            this.applyMood(
                this.currentMood,
                {
                    emit:
                        false,

                    persist:
                        false
                }
            );

            return this;
        }

        /* --------------------------------------------------------------------
         * DESTROY
         * ----------------------------------------------------------------- */

        destroy() {
            if (
                this.destroyed
            ) {
                return;
            }

            this.listeners.forEach(
                ({
                    target,
                    eventName,
                    handler
                }) => {
                    target.removeEventListener(
                        eventName,
                        handler
                    );
                }
            );

            this.listeners =
                [];

            this.sceneListenerBound =
                false;

            this.initialized =
                false;

            this.destroyed =
                true;
        }
    }

    /* ------------------------------------------------------------------------
     * SINGLETON
     * --------------------------------------------------------------------- */

    let manager =
        null;

    /* ------------------------------------------------------------------------
     * PUBLIC API
     * --------------------------------------------------------------------- */

    const api = {
        VERSION,

        init(
            options = {}
        ) {
            if (!manager) {
                manager =
                    new BirthdayThemeManager(
                        options
                    );
            }

            return manager.init(
                options
            );
        },

        getManager() {
            if (!manager) {
                manager =
                    new BirthdayThemeManager();

                manager.init();
            }

            return manager;
        },

        setMood(
            mood,
            options = {}
        ) {
            return this.getManager()
                .setMood(
                    mood,
                    options
                );
        },

        getMood() {
            return this.getManager()
                .getMood();
        },

        setThemeName(
            name,
            options = {}
        ) {
            return this.getManager()
                .setThemeName(
                    name,
                    options
                );
        },

        setColor(
            name,
            value,
            options = {}
        ) {
            return this.getManager()
                .setColor(
                    name,
                    value,
                    options
                );
        },

        setColors(
            colors,
            options = {}
        ) {
            return this.getManager()
                .setColors(
                    colors,
                    options
                );
        },

        setEffect(
            effect,
            enabled,
            options = {}
        ) {
            return this.getManager()
                .setEffect(
                    effect,
                    enabled,
                    options
                );
        },

        setIntensity(
            value,
            options = {}
        ) {
            return this.getManager()
                .setIntensity(
                    value,
                    options
                );
        },

        getTheme() {
            return this.getManager()
                .getTheme();
        },

        getState() {
            return this.getManager()
                .getState();
        },

        reset(
            options = {}
        ) {
            return this.getManager()
                .reset(
                    options
                );
        },

        refresh() {
            return this.getManager()
                .refresh();
        },

        persist() {
            return this.getManager()
                .persist();
        },

        destroy() {
            if (
                manager
            ) {
                manager.destroy();
            }

            manager =
                null;
        }
    };

    /* ------------------------------------------------------------------------
     * GLOBAL EXPORTS
     * --------------------------------------------------------------------- */

    window.BirthdayThemeManager =
        BirthdayThemeManager;

    window.SehrishTheme =
        api;

    window.SehrishBirthdayTheme =
        api;

    window.BirthdayThemeMoods =
        MOODS;

    /* ------------------------------------------------------------------------
     * AUTO BOOT
     * --------------------------------------------------------------------- */

    const boot = () => {
        try {
            api.init();
        } catch (
            error
        ) {
            console.error(
                "[SehrishTheme] " +
                "Initialization failed:",
                error
            );
        }
    };

    if (
        document.readyState ===
        "loading"
    ) {
        document.addEventListener(
            "DOMContentLoaded",
            boot,
            {
                once:
                    true
            }
        );
    } else {
        boot();
    }

    /* ------------------------------------------------------------------------
     * CELEBRATION INTEGRATION
     * --------------------------------------------------------------------- */

    window.addEventListener(
        "sehrish:gifts:all-opened",
        () => {
            api.setMood(
                "celebration"
            );
        }
    );

    window.addEventListener(
        "sehrish:quiz:completed",
        () => {
            api.setMood(
                "celebration"
            );
        }
    );

    window.addEventListener(
        "sehrish:cake:completed",
        () => {
            api.setMood(
                "cake"
            );
        }
    );

    window.addEventListener(
        "sehrish:letter:completed",
        () => {
            api.setMood(
                "celebration"
            );
        }
    );

    console.info(
        `[SehrishTheme] ` +
        `Theme module v${VERSION} loaded.`
    );
})();